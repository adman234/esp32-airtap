# Copy to secrets.yaml in your ESPHome config directory (never commit the real one).
wifi_ssid: "CHANGE_ME"
wifi_password: "CHANGE_ME"
ap_password: "CHANGE_ME"          # fallback hotspot, min 8 chars
web_password: "CHANGE_ME"         # on-device web UI, user "admin"
# 32-byte base64 key. Generate one: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Shared by all vents by default; give each its own secret name if you prefer.
airtap_api_key: "CHANGE_ME_base64_32_bytes_xxxxxxxxxxxxxxx="
